# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
# Root-level ignores (app/ and backend/ have their own .gitignore files).

# Knowledge-graph build output (regenerable via Graphify; never commit).
graphify-out/

# Local environment / secrets (backend/.env is also covered by backend/.gitignore).
.env
.env.local

# OS / editor noise.
.DS_Store
Thumbs.db

# Local backend run logs (uvicorn stdout/stderr redirects; never commit).
backend-local*.log
*.log

# Python / TypeScript build caches at root level.
__pycache__/
*.pyc
*.pyo
*.tsbuildinfo

# Python virtualenvs.
.venv/
venv/
ENV/

# Pytest / coverage caches.
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Local database artifacts — never commit dumps or local-only files.
*.sql
*.dump
*.bak
*.sqlite
*.sqlite3
*.db
pgdata/
data/

# Uploaded user content (served from backend/uploads/ at runtime; never commit).
backend/uploads/

# Local Docker volume state is in the container/volume, not the repo.
