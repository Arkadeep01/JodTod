# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
__pycache__/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files - never commit real secrets
.env
.env.*
!.env.example

# python virtualenvs
.venv/
venv/
ENV/

# python caches
__pycache__/
*.pyc
*.pyo

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# local database artifacts — never commit dumps or local-only files
*.sql
*.dump
*.bak
*.sqlite
*.sqlite3
*.db

# uploaded user content (runtime storage; never commit)
uploads/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
