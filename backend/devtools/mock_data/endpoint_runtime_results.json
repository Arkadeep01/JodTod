  "findings": [
    {
      "id": "BUG-1-reserved-tld-login-500",
      "severity": "high",
      "summary": "All seeded @jodtod.test users cannot authenticate.",
      "evidence": "POST /api/auth/login avery@jodtod.test -> HTTP 500: pydantic EmailStr rejects the reserved .test TLD in AuthenticatedUser.model_validate (auth_login_service.py:178). Signup with a .test email -> 422. Only arkadeep@admin.com works.",
      "impact": "Seed dataset is API-unusable for its original users; multi-user endpoint verification required locally-minted sessions."
    },
    {
      "id": "BUG-2-notification-serializer-500",
      "severity": "high",
      "summary": "GET/POST notification endpoints 500 for any user with rows.",
      "evidence": "EP-036 GET /api/notifications -> 500; NotificationItemResponse declares id:str/type:str/metadata but the ORM model exposes notification_type/context_data/UUID ids (schemas/notification.py vs models/notification.py).",
      "impact": "EP-036, EP-037, EP-038 fail for every user."
    },
    {
      "id": "BUG-3-silent-rollback-writes",
      "severity": "critical",
      "summary": "Group/expense/settlement/invitation writes return 200 but roll back.",
      "evidence": "Verified against jodtod_local: group rename/archive/rotate, join, add-member, expense create, settlement initiate and invitation create/accept all returned 200 with no persisted row (groups.name and invite_code unchanged; avery not added; arkadeep not in goa_trip; expenses stayed 7; no new settlement/invitation). Services read before `async with transaction(db)`, which cannot own the already-autobegun request session (same class as the previously fixed PATCH /users/me bug).",
      "impact": "9 endpoints silently no-op: EP-030,031,042,044,045,047,048,051,058 (plus EP-050 as a downstream 404, and EP-059/060/061/062)."
    }
  ],
