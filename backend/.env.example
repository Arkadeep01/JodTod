# JodTod backend environment template — PLACEHOLDERS ONLY, never real secrets.
#
# Copy for local development (from repo root):
#   Windows:  Copy-Item backend\.env.example backend\.env
#   macOS:    cp backend/.env.example backend/.env
#
# Then fill in real values in backend/.env (which is git-ignored and never committed).
# See README.md Steps 5-8 and docker-compose.local-db.yml for the local DB flow.

# --- Application ---
APP_NAME=JodTod API
ENVIRONMENT=development
DEBUG=false
API_VERSION=v1
HOST=0.0.0.0
PORT=5001

# --- Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
JWT_SECRET_KEY=replace-with-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP / verification ---
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Password policy ---
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# --- Database (primary: Supabase Postgres — the application's original database) ---
#
# Supabase remains the default/original target. The app reads DATABASE_URL
# from the environment, so Supabase is selected by setting it to your
# Supabase project credentials (pooler host). Placeholders only below —
# never commit real values.
#
# Pooler example (same style as README.md Step 5):
#   DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<SUPABASE_POOLER_HOST>:5432/postgres
DATABASE_URL=postgresql+asyncpg://<SUPABASE_USER>:<SUPABASE_PASSWORD>@<SUPABASE_POOLER_HOST>:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=false
DATABASE_ECHO=false

# --- Local Docker Postgres (isolated testing/demo ONLY — not the default) ---
#
# docker-compose.local-db.yml provides a throwaway database for demo seeding
# and scratch tests. Select it with an explicit shell override (never by
# changing the committed template):
#   $env:JODTOD_LOCAL_DB_PASSWORD = "choose-a-strong-local-password"
#   docker compose -f docker-compose.local-db.yml up -d
#   $env:DATABASE_URL = "postgresql+asyncpg://jodtod_dev:$env:JODTOD_LOCAL_DB_PASSWORD@127.0.0.1:55432/jodtod_local"
#   alembic upgrade head   # local container only — never run migrations against Supabase
#
# Password for the local Docker Postgres container (compose reads this env var).
# Set in your shell before `docker compose -f docker-compose.local-db.yml up -d`,
# never in a committed file:
#   $env:JODTOD_LOCAL_DB_PASSWORD = "choose-a-strong-local-password"
JODTOD_LOCAL_DB_PASSWORD=CHANGEME

# --- Tests use a separate scratch DB (backend/tests/conftest.py forces this) ---
# postgresql+asyncpg://postgres@localhost:55432/jodtod_test

# --- CORS ---
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# --- OAuth (leave empty until provider clients exist) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# --- OTP provider ---
OTP_PROVIDER=mock
OTP_PROVIDER_API_KEY=
OTP_RATE_LIMIT_MAX_PER_HOUR=10

# --- Email provider ---
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@jodtod.local
EMAIL_FROM_NAME=JodTod
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TEST_RECIPIENT=

# --- Request / network ---
MAX_REQUEST_BODY_MB=10
TRUSTED_PROXY_COUNT=0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Dev seed tooling (backend/devtools/mock_data/ — local databases ONLY) ---
# Demo seeding and cleanup refuse Supabase unconditionally (see guard.py);
# never pass --allow-remote for Supabase. Passwords come from env vars at
# seed time, never from committed files:
#   $env:JODTOD_SEED_PASSWORD = "dev-seed-password-8-or-more-chars"
#   $env:JODTOD_DEMO_ADMIN_PASSWORD = "demo-admin-password-8-or-more-chars"
JODTOD_SEED_PASSWORD=CHANGEME
JODTOD_DEMO_ADMIN_PASSWORD=CHANGEME
