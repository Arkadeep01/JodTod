# JodTod mobile environment template.
#
# Copy to `.env` for local runs:
#   Copy-Item app\.env.example app\.env
#
# URL contract (enforced by src/config/api.ts):
# - Value must be scheme + origin ONLY, e.g. https://api.jodtod.com
# - No trailing /api, no trailing slash (a trailing slash is tolerated
#   and stripped, but don't rely on it).
#
# Resolution order:
# - Dev (Expo Go / `expo start --lan`): EXPO_PUBLIC_API_URL wins when set;
#   otherwise the Metro host IP is used as http://<laptop-ip>:5001.
# - Dev over tunnel (`expo start --tunnel`): the tunnel forwards ONLY the
#   Metro port, never the API port, so auto-detection is disabled and this
#   variable is REQUIRED (point it at a reachable backend, e.g. your LAN IP
#   or a tunneled backend URL).
# - Release builds (EAS): REQUIRED. Empty/missing means every API call fails
#   and `apiConfigurationError` explains why instead of 404ing somewhere.

# Same-Wi-Fi dev against a laptop backend on port 5001 (replace the IP):
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001

# Production example (uncomment for release builds):
# EXPO_PUBLIC_API_URL=https://api.jodtod.com

# Optional: native Android Google OAuth client id. Leave empty until the
# Android Cloud-console client (package + SHA-1) exists; the app treats an
# empty value as null and keeps using the web client id flow.
GOOGLE_ANDROID_CLIENT_ID=
